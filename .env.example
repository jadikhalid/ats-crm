# Base de données (aligné avec application.yml)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=esn_ats
DB_USER=ats_user
DB_PASSWORD=ats_password

# API
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200

# JWT (Flyway utilisateurs — actif uniquement avec SECURITY_AUTH_MODE=jwt-local ou profil défaut sans prod)
JWT_SECRET=esn-ats-dev-secret-key-change-in-production-32b
JWT_EXPIRATION_MS=86400000
DEV_AUTH_ENABLED=true

# Sécurité
# Défaut développement : JWT local ; production Entra :
# SECURITY_AUTH_MODE=oauth2-resource-server
# SPRING_PROFILES_ACTIVE=prod
# Ou : SPRING_PROFILES_ACTIVE=azure  (également charge prod — voir spring.profiles.group dans application.yml)
SECURITY_AUTH_MODE=jwt-local
ENTRA_TENANT_ID=
ENTRA_ISSUER_URI=
# Audience API après « Expose an API », ex. api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_API_AUDIENCE=

# MySQL Azure (profil prod / azure ; sinon variables DB_* classiques ci-dessus)
AZURE_MYSQL_HOST=
AZURE_MYSQL_PORT=3306
AZURE_MYSQL_DATABASE=
AZURE_MYSQL_USER=
AZURE_MYSQL_PASSWORD=
HIKARI_MAX_POOL=15
HIKARI_MIN_IDLE=3

# Chemin optionnel vers le fichier .env (défaut : ../../.env depuis ats-api)
# ENV_FILE=../../.env

# IA (ne jamais committer les vraies clés)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_DEFAULT_PROVIDER=openai

# Azure (à configurer en phase infrastructure)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
